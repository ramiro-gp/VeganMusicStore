---
import { products, snapshot } from '../lib/catalog-data';
import { normalizeText, syncDate } from '../lib/catalog';
import { formatPrice, productMessage, whatsappUrl } from '../lib/whatsapp';
import ContactLink from './ContactLink.astro';
import { siteConfig } from '../config/site';
const status = { listed: 'Stock en lista · confirmar', out: 'Sin stock en lista · consultar', unknown: 'Consultar stock' };
---
<section class="catalog-body shell" aria-labelledby="catalog-list-title" data-catalog><h2 id="catalog-list-title" class="sr-only">Discos y vinilos del catálogo</h2><form class="catalog-controls" data-catalog-controls hidden role="search" aria-label="Buscar en el catálogo"><div class="search-field"><label for="catalog-search">¿Qué disco estás buscando?</label><input id="catalog-search" type="search" name="buscar" placeholder="Artista, álbum, sello…" autocomplete="off" data-search /></div><label class="stock-filter"><input type="checkbox" data-stock-filter /> Con stock informado</label><p class="catalog-count" aria-live="polite" aria-atomic="true" data-result-count>{products.length} títulos</p></form><p class="catalog-disclaimer">Precios en efectivo / transferencia. Confirmá edición, precio y disponibilidad.<br />Catálogo sincronizado el {syncDate(snapshot)}.</p><div class="catalog-column-labels" aria-hidden="true"><span>ARTISTA / ÁLBUM / EDICIÓN</span><span>PRECIO DE LISTA</span><span>CONSULTA</span></div><ul class="catalog-list">{products.map(item => { const url = whatsappUrl(productMessage(item)); return <li id={`disco-${item.id}`} data-catalog-item data-stock={item.stockStatus} data-search-text={normalizeText([item.sourceTitle, item.artist, item.album, item.origin, item.label].filter(Boolean).join(' '))}><h3>{item.sourceTitle}</h3><p class="catalog-item-meta">{[item.format, item.origin, item.label, status[item.stockStatus]].filter(Boolean).join(' · ')}</p><p class="catalog-item-price">{formatPrice(item.priceCashArs)}</p><a class="catalog-item-link" href={url ?? '/#contacto'} target={url ? '_blank' : undefined} rel={url ? 'noopener noreferrer' : undefined} aria-label={`Consultar por ${item.sourceTitle}`}>Consultar <span aria-hidden="true">↗</span></a></li> })}</ul><div class="catalog-empty" data-empty hidden><p class="large-copy">Ese disco todavía no aparece acá.</p><p>Probá con otra palabra o contanos qué estás buscando.</p><ContactLink class="button button-dark" message={siteConfig.messages.order}>Pedir un álbum</ContactLink></div></section>
<script>import '../scripts/catalog-search';</script>
