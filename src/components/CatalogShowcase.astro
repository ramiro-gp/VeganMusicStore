---
import { cartShowcase } from '../lib/catalog-data';
import RecordSlider from './RecordSlider.astro';
import PresaleShowcase from './PresaleShowcase.astro';
interface Props { context?: 'home' | 'cart'; }
const { context = 'home' } = Astro.props;
---
{context === 'cart' && cartShowcase.mode === 'presale' ? <PresaleShowcase items={cartShowcase.items} context={context} /> : <RecordSlider context={context} />}
