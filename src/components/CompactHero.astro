---
import VinylScene from './VinylScene.astro';
import DecorativeMark from './DecorativeMark.astro';
---
<section class="compact-hero" aria-labelledby="compact-hero-title">
  <div class="compact-hero-grid shell">
    <div class="compact-hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> DISCOS / VINILOS / IMPORTACIÓN</p>
      <h1 id="compact-hero-title"><span>VEGAN</span><span>MUSIC</span><span>STORE<DecorativeMark class="compact-title-mark" shape="spark" /></span></h1>
      <p class="compact-hero-description">Ese disco que venís buscando.<br /><span>Desde Almagro, a tu colección.</span></p>
    </div>
    <div class="compact-hero-art"><VinylScene /></div>
  </div>
</section>
