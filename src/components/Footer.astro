---
import { ArrowUpRight, Headphones } from '@lucide/astro';
import { siteConfig } from '../config/site';
import { routes } from '../config/variant';
import BrandLogo from './BrandLogo.astro';
---
<footer class="site-footer"><div class="shell"><div class="footer-top"><a href="/" class="footer-brand" aria-label="Vegan Music Store, inicio"><BrandLogo placement="footer" /></a><nav aria-label="Navegación del pie de página"><a href={routes.catalog}>Catálogo <ArrowUpRight size={15} aria-hidden="true" /></a><a href={routes.about}>Nosotros <ArrowUpRight size={15} aria-hidden="true" /></a><a href={routes.records}>Vegan Records <ArrowUpRight size={15} aria-hidden="true" /></a><a href={routes.contact}>Contacto <ArrowUpRight size={15} aria-hidden="true" /></a><a href={routes.cart}>Carrito de consulta <ArrowUpRight size={15} aria-hidden="true" /></a></nav></div><div class="footer-bottom"><p>{siteConfig.address.display}</p><p>DISCOS / VINILOS / IMPORTACIÓN</p><p>HECHO PARA ESCUCHAR.</p><p class="footer-credit">Hecho con <Headphones class="footer-credit-icon" size={15} aria-hidden="true" /> por <a href="https://ramita.dev" target="_blank" rel="noopener noreferrer">Ramiro Garcia</a></p></div></div></footer>
