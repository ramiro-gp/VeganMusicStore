---
import { ArrowUpRight, ShoppingBag, Menu, X } from '@lucide/astro';
import BrandLogo from './BrandLogo.astro';
import { siteConfig } from '../config/site';
import { whatsappUrl } from '../lib/whatsapp';
import { routes, siteVariant } from '../config/variant';
const importUrl = whatsappUrl(siteConfig.messages.import);
const navItems = [
  { href: routes.catalog, label: 'Catálogo' },
  { href: routes.about, label: 'Nosotros' },
  { href: routes.records, label: 'Vegan Records' },
  ...(siteVariant === 'v2' ? [{ href: routes.contact, label: 'Contacto' }] : []),
];
---
<header class="site-header" data-header>
  <div class="header-inner shell">
    <a class="wordmark" href="/" aria-label="Vegan Music Store, inicio"><BrandLogo /></a>
    <nav class="main-nav" id="main-navigation" aria-label="Navegación principal" data-main-nav>
      {navItems.map(item => <a href={item.href} aria-current={Astro.url.pathname !== '/' && Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}
      <a href={importUrl ?? routes.contact} target={importUrl ? '_blank' : undefined} rel={importUrl ? 'noopener noreferrer' : undefined}>A pedido</a>
    </nav>
    <div class="header-actions">
      <a class="header-cart" href={routes.cart} aria-label="Carrito de consulta" data-cart-link><ShoppingBag size={19} stroke-width={1.7} aria-hidden="true" /><span class="header-cart-label">Carrito</span><span class="cart-count" data-cart-count>0</span></a>
      <a class="button button-dark header-contact" href={routes.catalog}>CATÁLOGO <ArrowUpRight size={16} stroke-width={1.7} aria-hidden="true" /></a>
      <button class="menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false" aria-label="Abrir menú" data-menu-toggle><Menu class="menu-open-icon" size={23} aria-hidden="true" /><X class="menu-close-icon" size={23} aria-hidden="true" /></button>
    </div>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const navigation = document.querySelector<HTMLElement>('[data-main-nav]');
  if (toggle && navigation) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      navigation.dataset.open = String(open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    navigation.addEventListener('click', event => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
    });
    document.addEventListener('click', event => {
      if (!(event.target as Element).closest('.site-header')) setOpen(false);
    });
    matchMedia('(min-width: 1100px)').addEventListener('change', () => setOpen(false));
  }
</script>
