---
import { MapPin, ArrowUpRight } from '@lucide/astro';
import ContactLink from './ContactLink.astro';
import { siteConfig } from '../config/site';
---
<section class="location-section section-space shell" id="contacto" aria-labelledby="location-title"><div class="section-meta"><span class="eyebrow">04 / ENCONTRANOS</span><span class="eyebrow">DE ALMAGRO AL MUNDO</span></div><div class="location-grid"><div><h2 id="location-title">MEDRANO<br /><span class="accent">529.</span></h2><p class="location-address"><MapPin size={18} aria-hidden="true" /> Almagro, CABA</p></div><div class="location-copy"><p class="large-copy">El próximo disco<br />puede estar acá.</p><p>Medrano 529 — Almagro, CABA.<br />Consultanos por disponibilidad, pedidos y envíos a todo el mundo.</p><a class="text-link" href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer">Abrir ubicación en Maps <ArrowUpRight size={18} aria-hidden="true" /></a>{siteConfig.contact.whatsappNumber ? <ContactLink class="button button-dark">Hablar por WhatsApp</ContactLink> : <p class="contact-pending"><span class="status-dot"></span> WhatsApp pendiente de confirmar<span>Mientras tanto, encontranos en Medrano 529.</span></p>}</div></div><div class="map-embed"><iframe src={siteConfig.mapsEmbedUrl} title="Google Maps: Vegan Music Store, Medrano 529, Almagro, CABA" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div></section>
