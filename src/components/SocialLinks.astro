---
import { ArrowUpRight } from '@lucide/astro';
import { siteConfig } from '../config/site';
import InstagramIcon from '../assets/icons/instagram.svg';
import FacebookIcon from '../assets/icons/facebook.svg';
interface Props { brand: 'store' | 'records'; withIcons?: boolean; }
const { brand, withIcons = false } = Astro.props;
const brandName = brand === 'store' ? siteConfig.name : 'Vegan Records';
const links = siteConfig.social.filter(link => link.brand === brand);
---
<nav class="social-links" aria-label={`Redes de ${brandName}`}>
  {links.map(link => <a href={link.url} target="_blank" rel="noopener" referrerpolicy="strict-origin-when-cross-origin" aria-label={`${link.label} de ${brandName} (abre en otra pestaña)`}>
    {withIcons && (link.label === 'Instagram' ? <InstagramIcon width="17" height="17" aria-hidden="true" focusable="false" /> : <FacebookIcon width="17" height="17" aria-hidden="true" focusable="false" />)}<span>{link.label}</span>{!withIcons && <ArrowUpRight size={14} aria-hidden="true" />}
  </a>)}
</nav>
