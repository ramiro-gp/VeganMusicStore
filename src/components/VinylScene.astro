---
import DecorativeMark from './DecorativeMark.astro';
---
<div class="vinyl-scene" aria-hidden="true">
  <div class="sleeve-back"></div>
  <div class="vinyl-record"><div class="vinyl-grooves"></div><div class="vinyl-reflection"></div><div class="vinyl-label"><span>VEGAN STORE MUSIC</span><strong>VMS</strong><span>LADO A · 33⅓ RPM</span><i></i></div></div>
  <div class="record-sleeve">
    <div class="sleeve-top"><span>VEGAN STORE MUSIC</span><span>VMS—001</span></div>
    <div class="sleeve-art"><span class="sleeve-art-word">KEEP<br />DIGGING.</span><svg class="sleeve-orbit" viewBox="0 0 300 300" fill="none"><circle cx="150" cy="150" r="125" stroke="currentColor" stroke-width="1"/><circle cx="150" cy="150" r="105" stroke="currentColor" stroke-width="1"/><circle cx="150" cy="150" r="85" stroke="currentColor" stroke-width="1"/><circle cx="150" cy="150" r="65" stroke="currentColor" stroke-width="1"/><circle cx="150" cy="150" r="45" stroke="currentColor" stroke-width="1"/></svg><DecorativeMark class="sleeve-star" shape="spark" /></div>
    <div class="sleeve-bottom"><span>BUENOS AIRES<br />ARGENTINA</span><span>DISCOS QUE<br />SE QUEDAN.</span><span>33⅓<br />SIDE A</span></div>
  </div>
  <div class="vinyl-note"><span class="tiny-index">LADO A / 001</span><span>De Almagro<br />a tu colección.</span></div>
</div>
