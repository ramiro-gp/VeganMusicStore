---
import '../styles/global.css';
import '../styles/variants.css';
import '../styles/cart.css';
import '../styles/record-slider.css';
import '../styles/brand.css';
import { snapshot } from '../lib/catalog-data';
import '@fontsource/anton/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import antonFont from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
interface Props { title: string; description?: string; schema?: unknown[]; noindex?: boolean; }
const { title, description, schema, noindex } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F5F1F7" />
    <script is:inline>document.documentElement.classList.add('has-js');</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={antonFont} as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} schema={schema} noindex={noindex} />
  </head>
  <body data-catalog-synced-at={snapshot.syncedAt}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <p class="storage-notice shell" data-storage-notice hidden role="status">Tu navegador no permite guardar el carrito. La selección puede perderse al cambiar de página; podés consultar cada disco directamente por WhatsApp.</p>
    <main id="contenido" tabindex="-1"><slot /></main>
    <Footer />
    <script>import '../scripts/cart-global';</script>
  </body>
</html>
