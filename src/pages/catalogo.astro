---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogList from '../components/CatalogList.astro';
import ImportCallout from '../components/ImportCallout.astro';
import Location from '../components/Location.astro';
import CatalogIntro from '../components/CatalogIntro.astro';
import { siteVariant } from '../config/variant';
import { catalogSchema } from '../lib/catalog-schema';
if (siteVariant === 'v2') return Astro.redirect('/#catalogo', 301);
const origin = Astro.site ?? new URL('http://localhost:4321');
const schema = catalogSchema(origin);
---
<BaseLayout title="Catálogo de discos y vinilos — Vegan Store Music" description="Explorá el catálogo de Vegan Store Music: discos y vinilos, precios por medio de pago y carrito de consulta por WhatsApp." schema={schema}><CatalogIntro /><CatalogList /><ImportCallout /><Location /></BaseLayout>
