---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RecordSlider from '../components/RecordSlider.astro';
import PresaleShowcase from '../components/PresaleShowcase.astro';
import { presaleProducts } from '../lib/catalog-data';
import StoreDestinations from '../components/StoreDestinations.astro';
import CompactHero from '../components/CompactHero.astro';
import CatalogIntro from '../components/CatalogIntro.astro';
import CatalogList from '../components/CatalogList.astro';
import RecordsCallout from '../components/RecordsCallout.astro';
import ImportCallout from '../components/ImportCallout.astro';
import About from '../components/About.astro';
import Process from '../components/Process.astro';
import Location from '../components/Location.astro';
import { siteVariant } from '../config/variant';
import { catalogSchema } from '../lib/catalog-schema';
const variantTwo = siteVariant === 'v2';
const origin = Astro.site ?? new URL('http://localhost:4321');
---
<BaseLayout title={variantTwo ? 'Catálogo de discos y vinilos — Vegan Store Music' : 'CDs y discos de vinilo: venta e importación — Vegan Store Music'} description={variantTwo ? undefined : 'Venta e importación de CDs y discos de vinilo en Almagro, Buenos Aires. Explorá ediciones nacionales e importadas y consultá por álbumes a pedido. Envíos a todo el país y al mundo.'} schema={variantTwo ? catalogSchema(origin, false) : []}>
  {variantTwo ? <><CompactHero /><CatalogIntro compact /><CatalogList /><RecordsCallout /><ImportCallout /></> : <><Hero />{presaleProducts.length ? <PresaleShowcase items={presaleProducts} /> : <RecordSlider />}<StoreDestinations /><ImportCallout /><About /><Process /><Location /></>}
</BaseLayout>
